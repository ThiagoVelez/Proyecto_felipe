# =============================================================================
# SALUDCONECTA IPS v2.4 - PLANTILLA DE VARIABLES DE ENTORNO
# NOTA: Este archivo contiene solo valores ficticios de ejemplo.
# Copiar como .env y definir credenciales locales sin subir a Git.
# =============================================================================

# Servidor HTTP (Go Fiber)
PORT=8080
APP_ENV=development
APP_NAME=SaludConectaIPS

# Base de Datos (mysql, memory, postgres)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_db
DB_PASSWORD=tu_password_db
DB_NAME=saludconecta_db

# Seguridad Criptografica y Autenticacion (JWT / MFA)
JWT_SECRET=tu_clave_secreta_jwt_de_alta_entropia_aqui

# Politica de Origenes Cruzados (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Interoperabilidad Ministerial (Res. 2275 - RIPS)
IPS_NIT=000000000
COD_PRESTADOR=000000000000

# Configuracion del Cliente Frontend (React / Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
