# =============================================================================
# SALUDCONECTA IPS v2.4 - PLANTILLA DE VARIABLES DE ENTORNO (docker compose)
# Copiar como .env y definir valores privados. Nunca subir el .env a Git.
# =============================================================================

# Base de datos
DB_ROOT_PASSWORD=defina_una_clave_privada
DB_USER=saludconecta_user
DB_PASSWORD=defina_una_clave_privada

# Firma de tokens: obligatoria, minimo 32 caracteres aleatorios (ej. openssl rand -base64 48)
JWT_SECRET=defina_un_secreto_aleatorio_de_al_menos_32_caracteres
# Vigencias del esquema dual de tokens: Access Token (15 min) y Refresh Token (7 dias / 168 h)
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# Opcional. Administrador inicial: se crea solo si aun no existe ninguno. Contrasena de al menos 12 caracteres.
# Sin estas variables, el Encargado de TI y el administrador de cada sede se registran desde el inicio de sesion.
ADMIN_INITIAL_EMAIL=admin@su-institucion.example
ADMIN_INITIAL_PASSWORD=defina_una_clave_privada_larga

# Codigo de instalacion: habilita el registro del Encargado de TI desde el inicio de sesion (minimo 12 caracteres).
# Entreguelo en persona al Encargado de TI. Sin este codigo nadie puede registrarse como Encargado de TI.
TI_SETUP_CODE=defina_un_codigo_de_instalacion

# Identificacion de la IPS (RIPS)
IPS_NIT=000000000
COD_PRESTADOR=000000000000

# Redes del proxy inverso en las que se confia para leer la IP real del cliente (X-Real-IP)
TRUSTED_PROXIES=127.0.0.1,::1,172.28.0.10
