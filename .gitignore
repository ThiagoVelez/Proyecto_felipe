# =============================================================================
# EXCLUSION DE SEGURIDAD Y CONTROL DE VERSIONES
# =============================================================================

# 1. Variables de entorno y credenciales (Bloqueo estricto)
.env
.env.*
*.env
!.env.example
src/backend/.env
src/backend/.env.*
!src/backend/.env.example
src/frontend/.env
src/frontend/.env.*
!src/frontend/.env.example

# 2. Compilados y binarios de Go
*.exe
api
server
bin/
*.test
*.dll
*.so
*.dylib

# 3. Dependencias y compilados Web (Frontend)
node_modules/
src/frontend/node_modules/
dist/
src/frontend/dist/
.vite/
src/frontend/.vite/
build/

# 4. Reportes de pruebas y cobertura
coverage/
*.out
*.coverprofile

# 5. Logs del sistema
*.log
npm-debug.log*
yarn-debug.log*

# 6. Archivos de sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
