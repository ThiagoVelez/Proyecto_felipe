flowchart TD
    subgraph BrigadaRural ["Zona Rural Desconectada (Modo Offline PWA)"]
        Tablet["Dispositivo Movil / Tablet Asistencial"]
        LocalCache["Almacenamiento Local PWA (LocalStorage / IndexedDB)"]
        UUIDGen["Generador de Claves Idempotentes UUID v4"]
        OfflineQueue["Cola de Transacciones Locales (Triajes y Folios)"]

        Tablet -->|Atencion sin senal de red| UUIDGen
        UUIDGen --> OfflineQueue
        OfflineQueue --> LocalCache
    end

    subgraph RestablecimientoConexion ["Retorno a Sede Central / Deteccion de Red"]
        NetEvent["Evento navigator.onLine / Conexion Hospitalaria Establecida"]
        BatchBuilder["Constructor de Lote (Batch JSON: id, paciente, contenido, firma, closed_at)"]
        SyncService["Servicio de Sincronizacion PWA (src/services/api.js)"]

        LocalCache --> NetEvent
        NetEvent --> BatchBuilder
        BatchBuilder --> SyncService
    end

    subgraph BackendGo ["Servidor Central GoFiber & Base de Datos"]
        SyncEndpoint["POST /api/v1/sync/batch (JWT rol MEDICO)"]
        Sanitize["Descarta doctor_id, previous_hash y hash_sha256 del cliente; autor = medico autenticado"]
        IdempotencyCheck{"¿El UUID ya existe en BD?"}
        ClosedCheck{"¿El folio existente esta cerrado?"}
        Acknowledge["Se reconoce sin modificarlo (HTTP 200 idempotente, nunca se reabre)"]
        OwnerCheck{"¿Borrador de otro medico?"}
        SkipForeign["Se omite el registro"]
        ChainCompute["Calcula hash previo y hash en el servidor, encadenando al historial y dentro del lote (closed_at a segundos)"]
        PersistBatch["Transaccion atomica: SELECT ... FOR UPDATE, INSERT o UPDATE de borradores (is_offline_sync = TRUE)"]
        ChainConflict{"¿Conflicto de cadena concurrente?"}
        Retry["Recalcula el lote (hasta 5 intentos)"]
        AuditBatch["Registro en Bitacora de Auditoria Forense"]

        SyncService -->|Transmision por Lote| SyncEndpoint
        SyncEndpoint --> Sanitize
        Sanitize --> IdempotencyCheck
        IdempotencyCheck -->|Si existe| ClosedCheck
        IdempotencyCheck -->|No existe| ChainCompute
        ClosedCheck -->|Cerrado| Acknowledge
        ClosedCheck -->|Abierto| OwnerCheck
        OwnerCheck -->|Si| SkipForeign
        OwnerCheck -->|No, mismo autor| ChainCompute
        ChainCompute --> PersistBatch
        PersistBatch --> ChainConflict
        ChainConflict -->|Si| Retry
        Retry --> ChainCompute
        ChainConflict -->|No| AuditBatch
    end
